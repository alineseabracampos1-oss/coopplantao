# CoopPlantão · Variáveis de Ambiente
# ─────────────────────────────────────
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha com seus valores reais
# 3. NUNCA commite o .env no git (já está no .gitignore)

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ──────────────────────────────────────────────────────
# Sigla da cooperativa (deve bater com o campo `sigla` na tabela cooperativas)
VITE_COOPERATIVA_SIGLA=CEMERGE

# URL pública do app (usada nos magic links enviados via WhatsApp)
VITE_APP_URL=https://plantoes.cemerge.coop.br

# Ambiente (development | production | preview)
VITE_APP_ENV=development
